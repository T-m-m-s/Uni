  "weapon_mastery": [
    { "name": "Cleave", "description": "If you hit a creature with a melee attack, you can make a second attack against a different creature within 5 feet of the first and within your reach. The second hit deals weapon damage without your ability modifier (unless negative)." },
    { "name": "Graze", "description": "If you miss a creature with your attack roll, you deal damage equal to the ability modifier used for the roll." },
    { "name": "Nick", "description": "When you make an extra attack with a Light weapon (via the Light property), you can make that attack as part of the Attack action instead of using a Bonus Action." },
    { "name": "Push", "description": "When you hit a creature (Large or smaller), you can push it up to 10 feet straight away from you." },
    { "name": "Sap", "description": "When you hit a creature, it has Disadvantage on its next attack roll before the start of your next turn." },
    { "name": "Slow", "description": "When you hit a creature and deal damage, you reduce its Speed by 10 feet until the start of your next turn." },
    { "name": "Topple", "description": "When you hit a creature, you can force it to make a Constitution saving throw (DC 8 + Prof + Ability Mod) or fall Prone." },
    { "name": "Vex", "description": "When you hit a creature, you gain Advantage on your next attack roll against that same creature before the end of your next turn." }
  ],
