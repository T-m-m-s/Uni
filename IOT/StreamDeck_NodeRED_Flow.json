[
    {
        "id": "tab_streamdeck",
        "type": "tab",
        "label": "Stream Deck System",
        "disabled": false,
        "info": "Master Flow with Vuetify Macro Configurator, Dual Knobs with Mute, and Telemetry"
    },
    {
        "id": "ui_base_deck",
        "type": "ui-base",
        "name": "StreamDeck UI",
        "path": "/dashboard",
        "includeClientData": true,
        "acceptsClientConfig": [
            "ui-notification",
            "ui-control"
        ]
    },
    {
        "id": "ui_page_main",
        "type": "ui-page",
        "name": "Controls & Stats",
        "ui": "ui_base_deck",
        "path": "/main",
        "icon": "home",
        "layout": "grid",
        "theme": "theme_dark"
    },
    {
        "id": "theme_dark",
        "type": "ui-theme",
        "name": "Dark Theme",
        "colors": {
            "surface": "#1e1e1e",
            "primary": "#00bcd4",
            "bgPage": "#121212",
            "groupBg": "#242424",
            "groupOutline": "#333333"
        }
    },
    {
        "id": "grp_virtual_deck",
        "type": "ui-group",
        "name": "Virtual Stream Deck (6 Keys)",
        "page": "ui_page_main",
        "width": 6,
        "height": 0
    },
    {
        "id": "grp_system_stats",
        "type": "ui-group",
        "name": "PC Performance Stats (To Display)",
        "page": "ui_page_main",
        "width": 6,
        "height": 0
    },
    {
        "id": "grp_knobs",
        "type": "ui-group",
        "name": "Rotary Knobs (Volume & Mic Controls)",
        "page": "ui_page_main",
        "width": 6,
        "height": 0
    },
    {
        "id": "grp_macro_config",
        "type": "ui-group",
        "name": "🛠️ Configurazione Macro Dinamiche",
        "page": "ui_page_main",
        "width": 6,
        "height": 0
    },
    {
        "id": "timer_stats",
        "type": "inject",
        "z": "tab_streamdeck",
        "name": "Every 2s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "2",
        "crontab": "",
        "once": true,
        "onceDelay": "0.5",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,
        "y": 80,
        "wires": [
            [
                "exec_get_stats"
            ]
        ]
    },
    {
        "id": "exec_get_stats",
        "type": "exec",
        "z": "tab_streamdeck",
        "command": "python3 -c \"import psutil, json; print(json.dumps({'cpu': round(psutil.cpu_percent(0.1)), 'ram': round(psutil.virtual_memory().percent)}))\" 2>/dev/null || bash -c \"cpu=$(top -bn1 | grep 'Cpu(s)' | awk '{print 100 - $8}'); ram=$(free -m | awk '/Mem:/ {printf(\\\"%.0f\\\", $3/$2 * 100)}'); echo \\\"{\\\\\\\"cpu\\\\\\\": ${cpu:-0}, \\\\\\\"ram\\\\\\\": ${ram:-0}}\\\"\"",
        "addpay": "",
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Read CPU & RAM",
        "x": 330,
        "y": 80,
        "wires": [
            [
                "fn_parse_stats"
            ],
            [],
            []
        ]
    },
    {
        "id": "fn_parse_stats",
        "type": "function",
        "z": "tab_streamdeck",
        "name": "Split Stats",
        "func": "try {\n    var stats = JSON.parse(msg.payload.trim());\n    var msgCpu = { payload: stats.cpu };\n    var msgRam = { payload: stats.ram };\n    var msgAll = { payload: stats };\n    return [msgCpu, msgRam, msgAll];\n} catch(e) {\n    return null;\n}",
        "outputs": 3,
        "x": 530,
        "y": 80,
        "wires": [
            [
                "gauge_cpu"
            ],
            [
                "gauge_ram"
            ],
            [
                "debug_stats"
            ]
        ]
    },
    {
        "id": "gauge_cpu",
        "type": "ui-gauge",
        "z": "tab_streamdeck",
        "name": "CPU Usage",
        "group": "grp_system_stats",
        "order": 1,
        "width": 3,
        "height": 0,
        "gtype": "gauge-half",
        "gstyle": "needle",
        "title": "CPU Load",
        "units": "%",
        "min": 0,
        "max": 100,
        "value": "payload",
        "valueType": "msg",
        "segments": [
            {
                "from": 0,
                "color": "#5CD65C"
            },
            {
                "from": 50,
                "color": "#FFC800"
            },
            {
                "from": 80,
                "color": "#EA5353"
            }
        ],
        "x": 750,
        "y": 60,
        "wires": []
    },
    {
        "id": "gauge_ram",
        "type": "ui-gauge",
        "z": "tab_streamdeck",
        "name": "RAM Usage",
        "group": "grp_system_stats",
        "order": 2,
        "width": 3,
        "height": 0,
        "gtype": "gauge-half",
        "gstyle": "needle",
        "title": "RAM Usage",
        "units": "%",
        "min": 0,
        "max": 100,
        "value": "payload",
        "valueType": "msg",
        "segments": [
            {
                "from": 0,
                "color": "#5CD65C"
            },
            {
                "from": 50,
                "color": "#FFC800"
            },
            {
                "from": 80,
                "color": "#EA5353"
            }
        ],
        "x": 750,
        "y": 100,
        "wires": []
    },
    {
        "id": "debug_stats",
        "type": "debug",
        "z": "tab_streamdeck",
        "name": "Screen Payload",
        "active": false,
        "tosidebar": true,
        "console": false,
        "x": 760,
        "y": 140,
        "wires": []
    },
    {
        "id": "template_deck_buttons",
        "type": "ui-template",
        "z": "tab_streamdeck",
        "name": "Virtual Stream Deck Keys",
        "group": "grp_virtual_deck",
        "order": 1,
        "width": 6,
        "height": 0,
        "format": "<div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 4px;\">\n  <v-btn color=\"#1976D2\" @click=\"send({payload: {id: 0}})\" height=\"48\" style=\"font-weight: 600;\">🌐 Tasto 1</v-btn>\n  <v-btn color=\"#5865F2\" @click=\"send({payload: {id: 1}})\" height=\"48\" style=\"font-weight: 600;\">💬 Tasto 2</v-btn>\n  <v-btn color=\"#388E3C\" @click=\"send({payload: {id: 2}})\" height=\"48\" style=\"font-weight: 600;\">💻 Tasto 3</v-btn>\n  <v-btn color=\"#F57C00\" @click=\"send({payload: {id: 3}})\" height=\"48\" style=\"font-weight: 600;\">🔇 Tasto 4</v-btn>\n  <v-btn color=\"#C2185B\" @click=\"send({payload: {id: 4}})\" height=\"48\" style=\"font-weight: 600;\">🎤 Tasto 5</v-btn>\n  <v-btn color=\"#7B1FA2\" @click=\"send({payload: {id: 5}})\" height=\"48\" style=\"font-weight: 600;\">📷 Tasto 6</v-btn>\n</div>",
        "templateScope": "local",
        "x": 160,
        "y": 240,
        "wires": [
            [
                "fn_macro_router"
            ]
        ]
    },
    {
        "id": "fn_macro_router",
        "type": "function",
        "z": "tab_streamdeck",
        "name": "Wayland Macro Launcher",
        "func": "var data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) {}\n}\n\nvar defaultMacros = {\n    0: \"xdg-open https://google.com\",\n    1: \"vesktop\",\n    2: \"foot\",\n    3: \"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\",\n    4: \"wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle\",\n    5: \"grim -g \\\"$(slurp)\\\" - | wl-copy || flameshot gui\"\n};\n\nvar userMacros = global.get('deck_macros') || {};\nvar id = data.id;\nvar userCmd = userMacros[id] || defaultMacros[id];\n\nif (userCmd && userCmd.trim().length > 0) {\n    msg.payload = 'export WAYLAND_DISPLAY=\"${WAYLAND_DISPLAY:-wayland-1}\"; ' +\n                  'export DISPLAY=\"${DISPLAY:-:0}\"; ' +\n                  'export XDG_RUNTIME_DIR=\"${XDG_RUNTIME_DIR:-/run/user/1000}\"; ' +\n                  'setsid ' + userCmd + ' >/dev/null 2>&1 &';\n    return msg;\n} else {\n    return null;\n}",
        "outputs": 1,
        "x": 440,
        "y": 240,
        "wires": [
            [
                "exec_macro_launcher",
                "debug_actions"
            ]
        ]
    },
    {
        "id": "template_knobs",
        "type": "ui-template",
        "z": "tab_streamdeck",
        "name": "Dual Knobs Controls",
        "group": "grp_knobs",
        "order": 1,
        "width": 6,
        "height": 0,
        "format": "<div class=\"d-flex flex-column gap-3 pa-2\">\n  <div>\n    <div class=\"d-flex justify-space-between align-center mb-1\">\n      <span style=\"font-weight: 600; font-size: 0.95rem;\">🔊 Audio Output (Knob 0)</span>\n      <v-btn color=\"#E53935\" size=\"small\" variant=\"tonal\" @click=\"send({payload: {action: 'mute_out'}})\">\n        🔇 Mute Output\n      </v-btn>\n    </div>\n    <v-slider\n      v-model=\"volOut\"\n      min=\"0\"\n      max=\"100\"\n      step=\"5\"\n      color=\"#00bcd4\"\n      hide-details\n      @update:model-value=\"val => send({payload: {action: 'vol_out', val: val}})\"\n    ></v-slider>\n  </div>\n\n  <div class=\"mt-3\">\n    <div class=\"d-flex justify-space-between align-center mb-1\">\n      <span style=\"font-weight: 600; font-size: 0.95rem;\">🎙️ Microfono (Knob 1)</span>\n      <v-btn color=\"#E53935\" size=\"small\" variant=\"tonal\" @click=\"send({payload: {action: 'mute_mic'}})\">\n        🎤 Mute Mic\n      </v-btn>\n    </div>\n    <v-slider\n      v-model=\"volMic\"\n      min=\"0\"\n      max=\"100\"\n      step=\"5\"\n      color=\"#4CAF50\"\n      hide-details\n      @update:model-value=\"val => send({payload: {action: 'vol_mic', val: val}})\"\n    ></v-slider>\n  </div>\n</div>",
        "templateScope": "local",
        "x": 160,
        "y": 360,
        "wires": [
            [
                "fn_knob_router"
            ]
        ]
    },
    {
        "id": "fn_knob_router",
        "type": "function",
        "z": "tab_streamdeck",
        "name": "Knobs Router",
        "func": "var data = msg.payload;\nif (data.action === 'mute_out') {\n    msg.payload = \"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle\";\n} else if (data.action === 'vol_out') {\n    var vol = data.val;\n    msg.payload = \"wpctl set-volume @DEFAULT_AUDIO_SINK@ \" + (vol / 100).toFixed(2) + \" || pactl set-sink-volume @DEFAULT_SINK@ \" + vol + \"%\";\n} else if (data.action === 'mute_mic') {\n    msg.payload = \"wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle || pactl set-source-mute @DEFAULT_SOURCE@ toggle\";\n} else if (data.action === 'vol_mic') {\n    var vol = data.val;\n    msg.payload = \"wpctl set-volume @DEFAULT_AUDIO_SOURCE@ \" + (vol / 100).toFixed(2) + \" || pactl set-source-volume @DEFAULT_SOURCE@ \" + vol + \"%\";\n}\nreturn msg;",
        "outputs": 1,
        "x": 420,
        "y": 360,
        "wires": [
            [
                "exec_macro_launcher",
                "debug_actions"
            ]
        ]
    },
    {
        "id": "template_macro_config",
        "type": "ui-template",
        "z": "tab_streamdeck",
        "name": "Macro Config UI",
        "group": "grp_macro_config",
        "order": 1,
        "width": 6,
        "height": 0,
        "format": "<div class=\"d-flex flex-column gap-3 pa-2\">\n  <v-select\n    v-model=\"selectedKey\"\n    label=\"Seleziona Tasto da Configurare\"\n    :items=\"keyOptions\"\n    item-title=\"title\"\n    item-value=\"value\"\n    density=\"compact\"\n    variant=\"outlined\"\n    hide-details\n  ></v-select>\n\n  <v-text-field\n    v-model=\"customCmd\"\n    label=\"Comando / URL / App\"\n    placeholder=\"es. firefox https://github.com oppure obs o steam\"\n    density=\"compact\"\n    variant=\"outlined\"\n    hide-details\n    @keyup.enter=\"save()\"\n  ></v-text-field>\n\n  <v-btn\n    color=\"#009688\"\n    height=\"44\"\n    style=\"font-weight: 600; font-size: 1rem;\"\n    @click=\"save()\"\n    block\n  >\n    💾 SALVA MACRO\n  </v-btn>\n</div>\n\n<script>\nexport default {\n  data() {\n    return {\n      selectedKey: 0,\n      customCmd: '',\n      keyOptions: [\n        { title: 'Tasto 1 (Default: Google Browser)', value: 0 },\n        { title: 'Tasto 2 (Default: Vesktop Discord)', value: 1 },\n        { title: 'Tasto 3 (Default: Foot Terminal)', value: 2 },\n        { title: 'Tasto 4 (Default: Mute Audio)', value: 3 },\n        { title: 'Tasto 5 (Default: Mute Mic)', value: 4 },\n        { title: 'Tasto 6 (Default: Screenshot)', value: 5 }\n      ]\n    }\n  },\n  methods: {\n    save() {\n      if (!this.customCmd || this.customCmd.trim() === '') return;\n      this.send({\n        payload: {\n          event: 'save_macro',\n          keyId: this.selectedKey,\n          cmd: this.customCmd.trim()\n        }\n      });\n    }\n  }\n}\n</script>",
        "templateScope": "local",
        "x": 160,
        "y": 480,
        "wires": [
            [
                "fn_save_macro"
            ]
        ]
    },
    {
        "id": "fn_save_macro",
        "type": "function",
        "z": "tab_streamdeck",
        "name": "Save Macro Handler",
        "func": "var data = msg.payload;\nif (data && data.event === 'save_macro') {\n    var defaultMacros = {\n        0: \"xdg-open https://google.com\",\n        1: \"vesktop\",\n        2: \"foot\",\n        3: \"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\",\n        4: \"wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle\",\n        5: \"grim -g \\\"$(slurp)\\\" - | wl-copy || flameshot gui\"\n    };\n\n    var macros = global.get('deck_macros') || defaultMacros;\n    var keyIndex = parseInt(data.keyId);\n    macros[keyIndex] = data.cmd;\n    global.set('deck_macros', macros);\n\n    msg.payload = \"✅ Tasto \" + (keyIndex + 1) + \" salvato con successo: \" + data.cmd;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "x": 420,
        "y": 480,
        "wires": [
            [
                "ui_save_notification"
            ]
        ]
    },
    {
        "id": "ui_save_notification",
        "type": "ui-notification",
        "z": "tab_streamdeck",
        "name": "Notify Saved",
        "ui": "ui_base_deck",
        "position": "top right",
        "displayTime": "3500",
        "raw": false,
        "x": 670,
        "y": 480,
        "wires": []
    },
    {
        "id": "exec_macro_launcher",
        "type": "exec",
        "z": "tab_streamdeck",
        "command": "",
        "addpay": "payload",
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Run Command on PC",
        "x": 700,
        "y": 280,
        "wires": [
            [],
            [],
            []
        ]
    },
    {
        "id": "debug_actions",
        "type": "debug",
        "z": "tab_streamdeck",
        "name": "Executed Command",
        "active": true,
        "tosidebar": true,
        "console": false,
        "x": 700,
        "y": 340,
        "wires": []
    }
]
