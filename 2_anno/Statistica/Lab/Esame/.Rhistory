curve(dnorm(x,0.5,sqrt(1/(100*12))),col="red",add=T)
hist(media[,3], prob=T,main="n = 200",xlab="")
curve(dnorm(x,0.5,sqrt(1/(200*12))),col="red",add=T)
hist(media[,4], prob=T,main="n = 500",xlab="")
curve(dnorm(x,0.5,sqrt(1/(500*12))),col="red",add=T)
# Studiare la gaussianità della distribuzione delle somme con un istogramma e aggiungere la densità delle v.a. gaussiane relative all’approssimazione normale per le varie numerosità campionarie.
par(mfrow=c(2,2))
hist(somma[,1], prob=T,main="n = 50",xlab="")
curve(dnorm(x,50*0.5,sqrt(50/12)),col="red",add=T)
hist(somma[,2], prob=T,main="n = 100",xlab="")
curve(dnorm(x,100*0.5,sqrt(100/12)),col="red",add=T)
hist(somma[,3], prob=T,main="n = 200",xlab="")
curve(dnorm(x,200*0.5,sqrt(200/12)),col="red",add=T)
hist(somma[,4], prob=T,main="n = 500",xlab="")
curve(dnorm(x,500*0.5,sqrt(500/12)),col="red",add=T)
# Studiare la gaussianità della distribuzione delle somme con il QQ plot.
par(mfrow=c(2,2))
qqnorm(somma[,1], main="n = 50",xlab="")
